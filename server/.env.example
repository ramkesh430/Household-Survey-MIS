NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hhs
DB_PASSWORD=change-me
DB_NAME=hhs_dev
DB_NAME_TEST=hhs_test
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
AUTO_MIGRATE=true
# first admin account (npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2083
SEED_DEMO=false
DEMO_USER_PASSWORD=Demo@12345

# data-quality thresholds
QUALITY_GPS_OUTLIER_KM=2
QUALITY_GPS_POOR_ACCURACY_M=50
# field-level encryption of sensitive answers (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP A COPY OUTSIDE THE SERVER: without it encrypted answers (and backups) cannot be read.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# previous keys during rotation, e.g. k0:<base64key>
ENCRYPTION_OLD_KEYS=
# backups (admin UI → Backups). Directory must be on a persistent volume and copied off-site regularly.
BACKUP_DIR=./backups
BACKUP_SCHEDULE=true
BACKUP_HOUR_UTC=19
BACKUP_RETENTION_DAYS=14
BACKUP_UPLOAD_LIMIT=500mb
