# docker compose settings — copy to .env and change EVERY value marked change-*
DB_NAME=hhs
DB_USER=hhs
DB_PASSWORD=change-this-db-password
DB_ROOT_PASSWORD=change-this-root-password
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-64-char-random-string
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy OFF the server (password manager / sealed envelope). Losing it = sensitive answers unreadable.
ENCRYPTION_KEY=change-this-32-byte-base64-key
ENCRYPTION_KEY_ID=k1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
PUBLIC_URL=https://survey.example.gov.np
DOMAIN=survey.example.gov.np
WEB_PORT=8080
BACKUP_SCHEDULE=true
BACKUP_HOUR_UTC=19
BACKUP_RETENTION_DAYS=14
